# Keep the build context tiny and avoid stat-ing runtime/data dirs that may be
# root-owned (e.g. a dev bind-mount's ./data-dev), which breaks `docker build`.
.git
__pycache__/
*.pyc
data/
data-dev/
*.bak
docker-compose*.yml
# Not used by the image build (Dockerfile only copies app.py, probe.*, static/);
# keep the ~16 MB of docs media + site/design out of the build context.
docs/
website/
design/
.github/
scripts/
*.md
# …but the MCP sidecar image (mcp/Dockerfile, context = repo root) bundles the
# CHANGELOG as a resource, so keep that one file in the build context. The main
# image's Dockerfile COPYs only app.py/probe.*/static/, so re-including it here is
# harmless for that build.
!CHANGELOG.md
mkdocs.yml
